# SWISSAI Environment Configuration
# Copy this to ../../.env when deploying to SWISSAI

# Environment identifier
ENVIRONMENT=swissai

# API Keys - SWISSAI specific
GEMINI_API_KEY=your_swissai_gemini_api_key_here
CLAUDE_API_KEY=your_swissai_claude_api_key_here

# Cloudflare Tunnel - SWISSAI specific token
CLOUDFLARE_TOKEN_SWISSAI=your_swissai_cloudflare_tunnel_token_here

# SWISSAI specific settings
NODE_ENV=production
MCP_PORT=3000
SOCKET_MCP_PORT=3001
LOG_LEVEL=info
ALLOWED_HOSTS=localhost,127.0.0.1,mcp-gateway,api.geminiswiss1909.online,swissai.internal
ENABLE_SOCKET_MCP=true

# SWISSAI workspace identifier
WORKSPACE_ID=swissai-geminiswiss
DEPLOYMENT_REGION=eu-central
