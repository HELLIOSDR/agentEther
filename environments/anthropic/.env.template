# Anthropic Cloud Environment Configuration
# Copy this to ../../.env when deploying to Anthropic Cloud

# Environment identifier
ENVIRONMENT=anthropic

# API Keys - Anthropic Cloud specific
GEMINI_API_KEY=your_anthropic_gemini_api_key_here
CLAUDE_API_KEY=your_anthropic_claude_api_key_here

# Cloudflare Tunnel - Anthropic Cloud specific token
CLOUDFLARE_TOKEN_ANTHROPIC=your_anthropic_cloudflare_tunnel_token_here

# Anthropic Cloud specific settings
NODE_ENV=production
MCP_PORT=3000
SOCKET_MCP_PORT=3001
LOG_LEVEL=info
ALLOWED_HOSTS=localhost,127.0.0.1,mcp-gateway,api.geminiswiss1909.online
ENABLE_SOCKET_MCP=true

# Anthropic workspace identifier
WORKSPACE_ID=anthropic-cloud
DEPLOYMENT_REGION=us-east
